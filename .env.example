# WordPress site base URL (no trailing slash), e.g. https://example.com
WP_SITE_URL=https://your-site.com

# WordPress username used to create the Application Password
WP_USERNAME=your-wp-username

# Application Password generated in WordPress admin
# (Users > Profile > Application Passwords). Keep the spaces as-is or remove them, both work.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: default post status when not specified by the caller (draft | publish | pending | private)
WP_DEFAULT_STATUS=draft
